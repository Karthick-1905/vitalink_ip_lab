# Copy to .env.docker and populate before starting Docker Compose.
# Raw env-file format: do not wrap values in quotes or add inline comments.
# Full variable inventory: .env.example
NODE_ENV=production
MONGO_URI=mongodb+srv://USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/VitaLink?retryWrites=true&w=majority
JWT_SECRET=
ADMIN_TOTP_ENCRYPTION_KEY=
API_VERSION=v1
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Direct HTTP access; set the trusted proxy count only when using a real proxy.
TRUST_PROXY=false
API_DOCS_ENABLED=false

# Existing production requirements: S3-compatible storage and Twilio Verify.
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
# Use the coordinated migration instant when legacy key-only writers were drained.
FILE_ASSET_LEGACY_CUTOFF_AT=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
MALWARE_SCAN_ENABLED=true
MALWARE_SCAN_URL=
MALWARE_SCAN_AUTH_TOKEN=

# Compose supplies this URL for its Redis container and overrides env-file values.
REDIS_URL=redis://redis:6379
NOTIFICATION_DELIVERY_ENABLED=true
FCM_ENABLED=false
# Only needed when FCM_ENABLED=true; JSON must occupy one unquoted line.
FIREBASE_SERVICE_ACCOUNT=
DOSAGE_REMINDER_TIMEZONE=Asia/Kolkata
LOG_LEVEL=info
